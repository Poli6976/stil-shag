# Скопируйте в .env.local для локальной разработки (vercel dev) —
# на самом Vercel эти же имена задаются в Settings → Environment Variables,
# .env.local туда не попадает и в репозиторий коммитить его не нужно.

# Authorization key из личного кабинета GigaChat API:
# developers.sber.ru → создать проект "GigaChat API" → Авторизационные данные
GIGACHAT_AUTH_KEY=

# GIGACHAT_API_PERS — для физлица/самозанятого, GIGACHAT_API_B2B — для юрлица.
# Уточняется при подключении тарифа в личном кабинете.
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Необязательно — какую модель GigaChat использовать. По умолчанию базовая
# GigaChat (дешевле всего), GigaChat-Max — точнее и дороже.
GIGACHAT_MODEL=GigaChat

# ---- Коды программы «Примерка» (api/generate-code.js, api/redeem-code.js) ----

# Секрет, которым подписываются коды (формула — lib/partnerCode.js). Любая
# длинная случайная строка, например сгенерированная командой:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Если он утечёт — кто угодно сможет подделывать валидные коды. Никогда не
# показывать, не публиковать, не использовать тот же секрет для ADMIN_KEY.
PARTNER_CODE_SECRET=

# Пароль для служебных страниц владельца сайта (api/admin.js — выдача кодов
# admin-generate-code.html). Тоже длинная случайная строка (сгенерировать так
# же, как выше), но ДРУГАЯ, не равная PARTNER_CODE_SECRET.
ADMIN_KEY=

# ---- База данных, вход и письма (с 2026-10-23 — свой сервер в России вместо Supabase) ----
# Сервер готовит scripts/setup-server.sh, оба значения он пишет в /root/stil-connection.txt.
# DATABASE_CA — сертификат сервера целиком (строки BEGIN/END включительно).
DATABASE_URL=
DATABASE_CA=

# Секрет для кодов входа и подписанных ссылок на картинки — длинная случайная
# строка (как PARTNER_CODE_SECRET ниже, но ДРУГАЯ).
AUTH_SECRET=

# Ящик, с которого уходят письма с кодом входа (Яндекс Почта, пароль приложения
# из Яндекс ID → Безопасность → Пароли приложений — не пароль от ящика).
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Необязательно: MAIL_FROM=Стиль <stil-shag@yandex.ru>
MAIL_FROM=

# Только для разового переноса данных (scripts/migrate-from-supabase.js, файл
# .env.migrate) — на Vercel после переезда не нужны:
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Магазин Robokassa (robokassa.ru → личный кабинет → Настройки магазина).
# ROBOKASSA_MERCHANT_LOGIN — логин магазина оттуда же.
# ROBOKASSA_PASSWORD1 — «Пароль #1», подписывает ссылку на оплату.
# ROBOKASSA_PASSWORD2 — «Пароль #2», подписывает уведомление ResultURL
# (lib/payments/robokassa.js) — расчётный счёт/реквизиты самозанятого
# указываются на стороне Robokassa при регистрации магазина, не здесь.
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=

# Необязательно — "1" включает тестовый режим Robokassa (платежи не списывают
# реальные деньги). Снять/убрать перед приёмом настоящих платежей.
ROBOKASSA_DEMO_MODE=

# Необязательно — публичный адрес сайта для return_url после оплаты
# (например https://stil-tvoy-shag.ru). Если не задано, берётся из
# заголовка запроса — для большинства случаев этого достаточно.
SITE_URL=

# ---- Ночная уборка (api/files.js?action=cleanup, расписание — vercel.json) ----
# Удаляет старые коды входа, истёкшие сессии и счётчики лимитов.
# Vercel сам добавляет заголовок Authorization: Bearer <CRON_SECRET> при вызове
# задач из vercel.json → crons. С этой переменной уборку может запустить
# только Vercel; без неё — уборка выполняется без проверки источника
# (это безопасно: она только удаляет устаревшее).
CRON_SECRET=
